# Normalize all text to LF in the repo and working tree
* text=auto eol=lf

# Windows scripts need CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files (no diff, no EOL conversion). Git LFS is not enabled yet.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.woff2 binary
*.wav   binary
*.mp4   binary
