# --- Dependencies / environments ---
node_modules/
.venv/
__pycache__/
*.pyc

# --- Secrets (only .env.example is committed) ---
.env
.env.*
!.env.example

# --- Claude Code personal overrides ---
.claude/settings.local.json

# --- Codex skills: installed locally, see AGENTS.md ---
.agents/

# --- Large / licensed media and downloads (folders kept via .gitkeep) ---
data/raw/*
!data/raw/.gitkeep
assets/music/*
!assets/music/.gitkeep
assets/broll/*
!assets/broll/.gitkeep

# --- Per-episode generated output ---
episodes/*/audio/
episodes/_sandbox/*/audio/
episodes/*/renders/
studio/out/

# --- Media files anywhere ---
*.wav
*.mp3
*.flac
*.mp4
*.mov
*.webm

# --- Model and tile caches ---
.cache/
tiles-cache/

# --- OS junk ---
Thumbs.db
.DS_Store

# --- IDE settings ---
.vscode/
.idea/
*.swp
*.code-workspace

# Map plates are regenerated by `vap.geo.plate`; their .json metadata is committed.
studio/public/plates/*.png
studio/public/terrain/
studio/public/maplibre/
studio/public/geo/
