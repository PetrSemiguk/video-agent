{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git pull *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git worktree *)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(gh *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git rebase *)",
      "PowerShell(git merge *)",
      "PowerShell(git checkout *)",
      "PowerShell(git restore *)",
      "PowerShell(git stash *)",
      "PowerShell(git clean *)",
      "PowerShell(git tag *)",
      "PowerShell(git remote *)",
      "PowerShell(git pull *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git revert *)",
      "PowerShell(git am *)",
      "PowerShell(git rm *)",
      "PowerShell(git mv *)",
      "PowerShell(git worktree *)",
      "PowerShell(git -C *)",
      "PowerShell(git -c *)",
      "PowerShell(gh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.mjs"
            ],
            "onFailure": "block",
            "statusMessage": "Checking the Git policy"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.ps1"
            ],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.ps1"
            ],
            "async": true
          }
        ]
      }
    ]
  }
}
