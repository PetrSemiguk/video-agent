{
  "name": "studio",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "maplibre-gl": "6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "studio": "remotion studio",
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:hello": "remotion render Hello out/hello.mp4",
    "still:hello": "remotion still Hello out/hello.png --frame=90",
    "still:glcheck": "remotion still GlCheck out/glcheck.png",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "still:plate": "remotion still PlateCheck",
    "prepare:maplibre": "node scripts/prepare-maplibre.mjs",
    "render:ab-a": "node scripts/prepare-maplibre.mjs && remotion render AbMapLibre out/ab-a-maplibre.mp4 --gl=angle --concurrency=1",
    "render:ab-b": "remotion render AbPlate out/ab-b-plate.mp4 --gl=angle --concurrency=1",
    "ab:side-by-side": "node scripts/ab-side-by-side.mjs",
    "still:geodebug": "remotion still GeoDebug"
  },
  "allowScripts": {
    "esbuild": false
  }
}
